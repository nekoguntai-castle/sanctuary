{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"],
    "baseUrl": "./",
    "paths": {
      "@sanctuary/shared/*": ["../shared/dist/*"]
    }
  },
  "include": ["src/**/*", "../shared/types/ambient-modules.d.ts"],
  "exclude": ["node_modules", "dist"]
}
