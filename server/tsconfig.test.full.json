{
  "extends": "./tsconfig.test.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["src/*"],
      "@fixtures/*": ["tests/fixtures/*"],
      "@sanctuary/shared/*": ["../shared/dist/*"]
    }
  },
  "files": [],
  "include": ["src/**/*", "tests/**/*", "../shared/**/*"]
}
