{
  "name": "sanctuary-docs-site",
  "private": true,
  "version": "0.0.0",
  "description": "Docusaurus site that renders Sanctuary's curated docs, service architecture pages, and auto-generated dependency graphs.",
  "allowScripts": {
    "core-js": false,
    "fsevents": false
  },
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "typecheck": "tsc --noEmit",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "test:compatibility": "node --test tests/dependency-compatibility.test.cjs",
    "prebuild": "node --test tests/dependency-compatibility.test.cjs"
  },
  "dependencies": {
    "@docusaurus/core": "~3.10.2",
    "@docusaurus/preset-classic": "~3.10.2",
    "@docusaurus/theme-mermaid": "~3.10.2",
    "@mermaid-js/layout-elk": "0.1.9",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svg-pan-zoom": "^3.6.2"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "~3.10.2",
    "@docusaurus/tsconfig": "~3.10.2",
    "@docusaurus/types": "~3.10.2",
    "@types/react": "^19.3.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "nanoid": "6.0.1",
    "serialize-javascript": "7.1.1",
    "svgo": "4.1.0",
    "uuid": "14.0.2",
    "webpack": "5.111.0",
    "image-size": "2.0.4",
    "colord": "2.10.0",
    "joi": "18.2.9",
    "qs": "6.16.0",
    "minimizer-webpack-plugin": "5.10.1"
  }
}
