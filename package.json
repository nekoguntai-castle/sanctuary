{
  "name": "sanctuary",
  "private": true,
  "version": "0.8.59",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.16 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.16 <12",
      "onFail": "error"
    }
  },
  "overrides": {
    "protobufjs": "7.6.5",
    "@grpc/grpc-js": "1.14.4",
    "form-data": "4.0.6",
    "hono": "4.12.26",
    "undici": "7.29.0",
    "zod": "4.3.6"
  },
  "allowScripts": {
    "@firebase/util": false,
    "@prisma/engines@7.8.0": true,
    "@stellar/stellar-sdk": false,
    "blake-hash": false,
    "cbor-extract": false,
    "esbuild@0.28.1": true,
    "fsevents": false,
    "msgpackr-extract": false,
    "prisma@7.8.0": true,
    "protobufjs": false,
    "tiny-secp256k1": false,
    "usb": false
  },
  "workspaces": [
    "shared",
    "server",
    "gateway"
  ],
  "scripts": {
    "dev": "vite --config config/tooling/vite.config.ts",
    "build": "vite build --config config/tooling/vite.config.ts",
    "build:analyze": "ANALYZE=1 vite build --config config/tooling/vite.config.ts",
    "preview": "vite preview --config config/tooling/vite.config.ts",
    "test": "vitest --config config/tooling/vitest.config.ts",
    "test:run": "vitest run --config config/tooling/vitest.config.ts",
    "test:related": "./scripts/run-tests.sh --since main",
    "test:related:since": "./scripts/run-tests.sh --since",
    "coverage": "npm run test:coverage:full; rc=$?; node scripts/ci/coverage-summary.mjs; sc=$?; [ $rc -ne 0 ] && exit $rc; exit $sc",
    "coverage:summary": "node scripts/ci/coverage-summary.mjs",
    "test:coverage": "vitest run --config config/tooling/vitest.config.ts --coverage",
    "test:coverage:shard": "bash scripts/ci/frontend-coverage-shard.sh",
    "test:coverage:merge": "bash scripts/ci/frontend-coverage-merge.sh",
    "test:coverage:full": "npm run test:coverage && npm run test:backend:coverage && cd gateway && npm run test:coverage",
    "test:integration": "./scripts/run-integration-tests.sh",
    "test:ops:phase2": "./scripts/run-integration-tests.sh tests/integration/ops/phase2OperationsProof.integration.test.ts",
    "test:all": "npm run test:run && npm run test:backend",
    "test:backend": "cd server && npm test",
    "test:backend:watch": "cd server && npm run test:watch",
    "test:backend:coverage": "cd server && npm run test:coverage",
    "test:docker": "docker compose --project-directory . -f docker/compose/test.yml run --rm test-all",
    "test:docker:backend": "docker compose --project-directory . -f docker/compose/test.yml run --rm backend-test",
    "test:docker:frontend": "docker compose --project-directory . -f docker/compose/test.yml run --rm frontend-test",
    "test:docker:coverage": "docker compose --project-directory . -f docker/compose/test.yml run --rm backend-coverage && docker compose --project-directory . -f docker/compose/test.yml run --rm frontend-coverage",
    "test:docker:clean": "docker compose --project-directory . -f docker/compose/test.yml down -v --remove-orphans",
    "ops:monitoring:phase2": "node scripts/ops/phase2-monitoring-smoke.mjs",
    "ops:alert-receiver:phase2": "node scripts/ops/phase2-alert-receiver-smoke.mjs",
    "ops:gateway-audit:phase2": "node scripts/ops/phase2-gateway-audit-compose-smoke.mjs",
    "test:e2e": "playwright test --config config/tooling/playwright.config.ts",
    "test:e2e:render": "playwright test --config config/tooling/playwright.config.ts --project=chromium tests/e2e/render-regression.spec.ts",
    "test:e2e:render:update": "playwright test --config config/tooling/playwright.config.ts --project=chromium tests/e2e/render-regression.spec.ts --update-snapshots",
    "test:e2e:ui": "playwright test --config config/tooling/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config config/tooling/playwright.config.ts --headed",
    "test:hygiene": "node scripts/test-hygiene.mjs",
    "perf:phase3": "node scripts/perf/phase3-benchmark.mjs",
    "perf:phase3:compose-smoke": "node scripts/perf/phase3-compose-benchmark-smoke.mjs",
    "typecheck": "npm run typecheck:all",
    "typecheck:all": "tsc --noEmit -p config/tooling/tsconfig.all.json",
    "typecheck:app": "tsc --noEmit -p config/tooling/tsconfig.app.json --noUnusedLocals --noUnusedParameters",
    "typecheck:tests": "tsc --noEmit -p config/tooling/tsconfig.tests.json --noUnusedLocals --noUnusedParameters",
    "typecheck:server:tests": "cd server && npm run typecheck:tests",
    "typecheck:scripts": "tsc --noEmit -p config/tooling/tsconfig.scripts.json --noUnusedLocals --noUnusedParameters",
    "lint": "npm run lint:app && npm run lint:server && npm run lint:gateway && npm run check:blocking-io",
    "lint:app": "eslint --config config/tooling/eslint.config.js \"src/**/*.{ts,tsx}\" \"shared/**/*.ts\"",
    "lint:server": "eslint --config config/tooling/eslint.config.js \"server/src/**/*.ts\" \"shared/**/*.ts\" && npm run check:api-body-validation && npm run check:bitcoin-network-boundaries && npm run check:safety-catch-guards",
    "lint:gateway": "eslint --config config/tooling/eslint.config.js \"gateway/src/**/*.ts\" \"shared/**/*.ts\"",
    "quality": "./scripts/quality.sh",
    "quality:lizard": "bash scripts/quality/lizard-only.sh",
    "check:browser-auth-contract": "node scripts/check-browser-auth-contract.mjs",
    "check:bitcoin-network-boundaries": "node scripts/check-bitcoin-network-boundaries.mjs",
    "check:safety-catch-guards": "node scripts/check-safety-catch-guards.mjs",
    "check:github-action-runtimes": "node scripts/ci/check-github-action-runtimes.mjs && node scripts/ci/vendor/forgejo-artifact-v4/verify-vendor.mjs .github/actions/vendor/forgejo-artifact-v4",
    "check:npm-install-scripts": "node scripts/ci/check-npm-install-scripts.mjs",
    "check:ioc-sweep": "node scripts/ci/ioc-sweep.mjs",
    "test:ioc-sweep": "node --test tests/ci/ioc-sweep.test.mjs",
    "check:npm-ci-callsites": "node scripts/ci/check-npm-ci-callsites.mjs",
    "check:architecture-boundaries": "node scripts/check-architecture-boundaries.mjs",
    "check:openapi-route-coverage": "node scripts/check-openapi-route-coverage.mjs",
    "check:semgrep-baseline": "node scripts/quality/check-semgrep-baseline.mjs reports/semgrep/semgrep.json scripts/quality/semgrep-baseline.json",
    "check:api-body-validation": "node scripts/check-api-body-validation.mjs",
    "check:blocking-io": "node scripts/check-blocking-io.mjs",
    "release:publish": "scripts/release/publish-release.sh",
    "release:prepare-assets": "node scripts/release/prepare-release-assets.mjs",
    "release:publish-assets": "node scripts/release/publish-release-assets.mjs",
    "release:verify-artifacts": "scripts/release/verify-release-artifacts.sh",
    "test:release-distribution": "bash tests/release/create-forge-release.test.sh && bash tests/release/publish-release.test.sh && node tests/release/verify-release-artifacts.test.mjs && node tests/release/prepare-release-assets.test.mjs && node tests/release/publish-release-assets.test.mjs",
    "test:release-artifacts": "node tests/release/verify-release-artifacts.test.mjs",
    "test:mutation": "stryker run config/tooling/stryker.config.mjs",
    "test:mutation:backend": "cd server && npx stryker run",
    "test:mutation:critical:backend": "cd server && npm run test:mutation:critical:gate",
    "arch:graphs": "node scripts/architecture/generate-graphs.mjs",
    "arch:calls": "node scripts/architecture/extract-call-graphs.mjs",
    "arch:lint": "node scripts/architecture/lint-diagrams.mjs",
    "arch:check": "npm run arch:graphs && npm run arch:calls && git diff --exit-code -- docs/architecture/generated && npm run arch:lint",
    "docs:start": "npm --prefix docs/site run start",
    "docs:build": "npm --prefix docs/site run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@keystonehq/bc-ur-registry": "^0.7.1",
    "@ledgerhq/hw-app-btc": "^10.13.0",
    "@ledgerhq/hw-transport-webusb": "^6.29.13",
    "@ledgerhq/ledger-bitcoin": "^0.3.1",
    "@ngraveio/bc-ur": "^1.1.13",
    "@tanstack/react-query": "^5.90.12",
    "@trezor/connect-web": "^9.7.0",
    "@yudiel/react-qr-scanner": "^2.5.0",
    "bitbox02-api": "^0.15.1",
    "bitcoinjs-lib": "^7.0.1",
    "cbor-x": "^1.6.0",
    "lucide-react": "^1.8.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "7.18.2",
    "react-virtuoso": "^4.17.0",
    "recharts": "^3.5.1",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.49.1",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/w3c-web-hid": "^1.0.6",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/w3c-web-usb": "^1.0.13",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.16",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vitest": "^4.1.4"
  }
}
