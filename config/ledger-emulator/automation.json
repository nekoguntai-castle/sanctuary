{
  "version": 1,
  "rules": [
    {
      "regexp": "Approve|Accept|Hold to sign|Sign transaction|Confirm",
      "actions": [
        ["button", 1, true],
        ["button", 2, true],
        ["button", 2, false],
        ["button", 1, false]
      ]
    },
    {
      "regexp": "Review|Verify|Amount|Address|To|Fees|Tap to continue",
      "actions": [
        ["button", 2, true],
        ["button", 2, false]
      ]
    }
  ]
}
