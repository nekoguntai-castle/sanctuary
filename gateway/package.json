{
  "name": "sanctuary-gateway",
  "version": "0.8.73",
  "description": "Public API gateway for Sanctuary mobile apps",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=junit",
    "lint": "cd .. && npm run lint:gateway"
  },
  "dependencies": {
    "@parse/node-apn": "^8.0.0",
    "@sanctuary/shared": "*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^3.0.7",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^24.12.2",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
