{
  "$comment": "Docs screenshot manifest for npm run demo:capture. Routes may reference seeded wallets as {wallet:<name>} (names from scripts/demo/manifest.json). click opens a tab or button by its visible name. themes defaults to both; README shots need both (<picture> pairs), docs pages embed the dark image with Markdown syntax so Docusaurus bundles it. overlay=funded swaps in the balances below for wallet list/detail and balance history only; every other response is the live demo instance's real data.",
  "overlays": {
    "funded": {
      "balances": {
        "Everyday spending": 4210337,
        "Taproot savings": 58400000,
        "Family vault": 125000000
      }
    }
  },
