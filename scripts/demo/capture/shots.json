      "name": "dashboard",
      "route": "/",
      "overlay": "funded"
    },
    {
      "name": "wallet",
      "route": "/wallets/{wallet:Everyday spending}"
    },
    {
      "name": "wallet-utxos",
      "route": "/wallets/{wallet:Family vault}",
      "click": "UTXOs"
    },
    {
      "name": "send",
      "route": "/wallets/{wallet:Family vault}/send"
    },
    {
      "name": "devices",
      "route": "/devices"
    },
    {
      "name": "device-connect",
      "route": "/devices/connect",
      "themes": [
        "dark"
      ]
    },
    {
      "name": "settings",
      "route": "/settings"
    },
    {
      "name": "admin-feature-flags",
      "route": "/admin/feature-flags",
      "themes": [
        "dark"
      ]
    },
    {
      "name": "admin-ai-settings",
      "route": "/admin/ai",
      "themes": [
        "dark"
      ]
    },
    {
      "name": "admin-ai-mcp-access",
      "route": "/admin/ai",
