{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "root-layout-classification.schema.json",
  "title": "Sanctuary tracked root-layout contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "baseline",
    "maximumFiles",
    "maximumDirectories",
    "classifications",
    "retiredEntries"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "baseline": {
      "description": "Immutable tracked-root baseline captured before convergence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "files", "directories"],
      "properties": {
        "total": { "const": 67 },
        "files": { "const": 42 },
        "directories": { "const": 25 }
      }
    },
    "maximumFiles": {
      "description": "Final hard cap for tracked loose files at repository root.",
      "const": 10
    },
    "maximumDirectories": {
      "description": "Final hard cap for tracked directories at repository root.",
      "const": 12
    },
    "classifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conventional", "generated", "project", "tooling"],
      "properties": {
        "conventional": {
          "description": "Ecosystem and community contracts conventionally discovered at repository root.",
          "$ref": "#/$defs/classificationGroup"
        },
        "generated": {
          "description": "Committed machine-derived root artifacts.",
          "$ref": "#/$defs/classificationGroup"
        },
        "project": {
          "description": "First-party application, runtime, deployment, documentation, and test content.",
          "$ref": "#/$defs/classificationGroup"
        },
        "tooling": {
          "description": "Build, test, quality, and developer tooling contracts.",
          "$ref": "#/$defs/classificationGroup"
        }
      }
    },
    "retiredEntries": {
      "description": "Immutable top-level paths removed from the 67-entry baseline and prohibited from returning.",
      "$ref": "#/$defs/entryList"
    }
  },
  "$defs": {
    "classificationGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "directories"],
      "properties": {
        "files": { "$ref": "#/$defs/entryList" },
        "directories": { "$ref": "#/$defs/entryList" }
      }
    },
    "entryList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/]+$"
      },
      "uniqueItems": true
    }
  }
}
