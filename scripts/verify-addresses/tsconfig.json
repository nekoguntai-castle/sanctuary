{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "../..",
    "outDir": "dist",
    "declaration": true,
    "resolveJsonModule": true
  },
  "include": ["*.ts", "implementations/*.ts", "../../shared/constants/walletPolicy.ts"],
  "exclude": ["node_modules", "dist"]
}
