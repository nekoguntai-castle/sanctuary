{
  "name": "verify-addresses",
  "version": "1.0.0",
  "description": "Cross-implementation address verification for Sanctuary",
  "allowScripts": {
    "core-js": false,
    "esbuild@0.28.1": true,
    "fsevents": false,
    "tiny-secp256k1": false
  },
  "type": "module",
  "scripts": {
    "generate": "tsx generate-vectors.ts",
    "generate:repeatable": "./verify-repeatable.sh generate",
    "verify": "tsx generate-vectors.ts --verify-only",
    "verify:repeatable": "./verify-repeatable.sh verify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bip32": "^5.0.1",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "7.0.2",
    "bs58check": "^4.0.0",
    "tiny-secp256k1": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "node-linux-x64": "24.21.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "valibot": "1.5.0"
  }
}
